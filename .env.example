# Server-only credentials. Never prefix these with VITE_.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
SERPAPI_KEY=
SERPAPI_KEYS=
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
TME_TOKEN=
TME_APP_SECRET=
MASTER_SEARCH_API_KEY=
MASTER_SEARCH_URL=

# Hosted (Vercel) only. Database for accounts, sign-in lockouts and the part cache (supabase/schema.sql).
# The secret key stays on the server; the publishable key is only used by scripts/check-supabase.mjs.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Alternative to Supabase: Upstash for Redis (Vercel Marketplace sets these).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sign-up rules (also applied by npm run server when set here).
# The only address that can create the first (admin) account; required online.
ADMIN_EMAIL=
# Who may sign up after the admin: addresses and @domains, "*" for anyone, "none" for no one.
# Unset: anyone locally, no one online.
SIGNUP_ALLOW=
